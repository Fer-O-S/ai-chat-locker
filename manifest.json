{
    "manifest_version": 3,
    "name": "AI Chat Locker",
    "version": "1.2.0",
    "description": "Protege tus conversaciones de IA con un PIN.",
    "minimum_chrome_version": "111",
    "permissions": [
        "storage"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "AI Chat Locker",
        "default_popup": "src/popup/popup.html"
    },
    "options_ui": {
        "page": "src/popup/options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "src/background/service-worker.js"
    },
    "commands": {
        "lock-now": {
            "suggested_key": {
                "default": "Alt+Shift+L"
            },
            "description": "Bloquear ahora"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://gemini.google.com/*",
                "https://claude.ai/*",
                "https://www.instagram.com/*"
            ],
            "run_at": "document_start",
            "css": [
                "src/content/early.css"
            ],
            "js": [
                "src/shared/config.js",
                "src/shared/sites.js",
                "src/shared/styles.js",
                "src/shared/pin-form.js",
                "src/content/lock-screen.js",
                "src/content/inactivity.js",
                "src/content/chat-list.js",
                "src/content/main.js"
            ]
        }
    ]
}
